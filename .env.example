# Copy this file to `.env` for local development, and add the SAME values in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# All values come from Supabase → Project Settings → API (or "API Keys").

# --- Browser (safe to expose; protected by Row Level Security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Server (used during server-side rendering) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- Server only, NEVER prefix with VITE_ (only needed if you add admin server code) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Only for running drizzle-kit migrations from your computer ---
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
